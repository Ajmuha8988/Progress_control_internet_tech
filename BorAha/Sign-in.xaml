<Window x:Class="BorAha.Sign_in"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorAha"
        mc:Ignorable="d"
            Title="AuthorizationPage" Height="450" Width="450" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Viewbox>
            <Canvas Width="400" Height="450">
                <Button FontSize="40" Background="White" BorderBrush="White" Canvas.Left="370" Click="Button_Click_1" >X</Button>
                <Label Canvas.Top="50" FontSize="40" HorizontalContentAlignment="Center" Width="400">Вход</Label>
                <Label Width="400" FontSize="30" HorizontalContentAlignment="Left" Canvas.Top="120">Почта</Label>
                <Border CornerRadius="5" BorderThickness="1" BorderBrush="Black" Canvas.Top="170">
                    <TextBox Name="Email" Background="Transparent" BorderThickness="0" FontSize="30" Width="400" />
                </Border>
                <Label Width="400" FontSize="30" HorizontalContentAlignment="Left" Canvas.Top="210" Content="Пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border CornerRadius="5" BorderThickness="1" BorderBrush="Black" Canvas.Top="260">
                    <PasswordBox Name="password" Background="Transparent" BorderThickness="0" FontSize="30" Width="400" />
                </Border>
                <Button Canvas.Top="320" Canvas.Left="100" Width="200" FontSize="40" Content="Войти" BorderBrush="Black" Background="#003770" Foreground="White" Click="Button_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>