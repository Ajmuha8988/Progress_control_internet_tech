<Window x:Class="BorAha.Task"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorAha"
        mc:Ignorable="d"
        Title="Task" Height="450" Width="800" WindowState="Maximized" WindowStyle="None">
    <Grid>
        <Viewbox>
            <Canvas Width="100" Height="400" >
                <Label FontSize="40" Canvas.Left="-33" Canvas.Top="16" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" >Задача</Label>
                <Label Name="number" FontSize="40" Canvas.Left="100" Canvas.Top="16" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" >1</Label>
                <Button Width="50" Height="50" Canvas.Left="347" Canvas.Top="8" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Button_Click" BorderBrush="{x:Null}">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-logout-660350.png"/>
                    </Button.Background>
                </Button>
                <Button Width="50" Height="50" Canvas.Left="256" Canvas.Top="315" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_Click1" Name="bt1" BorderBrush="{x:Null}">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-arrowhead-thin-outline-to-the-left-32542.png"/>
                    </Button.Background>
                </Button>
                <Button Width="50" Height="50" Canvas.Left="310" Canvas.Top="315" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_Click2" Name="bt2" BorderBrush="{x:Null}">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-arrow-point-to-right-32213.png"/>
                    </Button.Background>
                </Button>
                <Frame NavigationUIVisibility="Hidden" x:Name="main" Width="610" Height="200" BorderBrush="Black" BorderThickness="2" Canvas.Left="-250" Canvas.Top="100" HorizontalAlignment="Left" VerticalAlignment="Top"></Frame>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
