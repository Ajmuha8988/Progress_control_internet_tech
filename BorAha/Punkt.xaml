<Window x:Class="BorAha.Punkt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorAha"
        mc:Ignorable="d"
        Title="Punkt" Height="450" Width="800" WindowState="Maximized" WindowStyle="None">
    <Grid>
        <Viewbox>
            <Canvas Width="100" Height="400" >
                <Button Width="50" Height="50" Canvas.Left="347" Canvas.Top="8" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Button_Click_1" BorderBrush="{x:Null}">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-logout-660350.png"/>
                    </Button.Background>
                </Button>
                <Label Foreground="Black" FontSize="40" HorizontalAlignment="Center" Canvas.Left="-169" VerticalAlignment="Top" Canvas.Top="24">Выберите нужный пункт</Label>
                <Button Canvas.Left="-120" Canvas.Top="240" FontSize="30" Content="Результаты тестирования" BorderBrush="Black" Background="{x:Null}" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_Click_2" >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Canvas.Left="-145" Canvas.Top="170" FontSize="30" Content="Приступить к тестированию" BorderBrush="Black" Background="{x:Null}" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_Click" >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Canvas.Left="-113" Canvas.Top="100" FontSize="30" Content="Приступить к задачам" BorderBrush="Black" Background="{x:Null}" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_Click_3" >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
                <Frame x:Name="Myfr" ></Frame>
            </Canvas>
        </Viewbox>
        <Grid.Background >
            <ImageBrush ImageSource="/110633-simmetriya-belye-illyustracii-poligon-informaciya-x750.jpg"/>
        </Grid.Background>

    </Grid>
</Window>
