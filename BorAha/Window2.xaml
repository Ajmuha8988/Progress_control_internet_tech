<Window x:Class="BorAha.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorAha"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Canvas>
        <Canvas.Background>
            <ImageBrush ImageSource="/standard-quality-control-concept-m.jpg"/>
        </Canvas.Background>
        <Button Canvas.Left="288" FontSize="30" Content="Перейти к таблице" BorderBrush="Black" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="288" Click="Button_Click" Background="#FFD0D0D0" >
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"></Setter>
                    <Setter Property="BorderBrush" Value="Black"></Setter>
                </Style>
            </Button.Resources>
        </Button>
        <Label FontSize="48" HorizontalAlignment="Left" Canvas.Left="256" VerticalAlignment="Center">Поздравляю!!!</Label>
        <Label FontSize="45
               " HorizontalAlignment="Left" Canvas.Left="82" VerticalAlignment="Center" Canvas.Top="72">Вы завершили тестирование</Label>
        <Label FontSize="45" HorizontalAlignment="Left" Canvas.Left="240" VerticalAlignment="Top" Canvas.Top="142">Результат:</Label>
        <Label FontSize="45" Name="esult" HorizontalAlignment="Left" Canvas.Left="480" VerticalAlignment="Center" Canvas.Top="142" Foreground="#FF800606">/5</Label>
        <Label FontSize="45" Name="Result" HorizontalAlignment="Left" Canvas.Left="458" VerticalAlignment="Center" Canvas.Top="142" Foreground="#FF800606">0</Label>
	</Canvas>
</Window>
