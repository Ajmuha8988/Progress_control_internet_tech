<Window x:Class="BorAha.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorAha"
        mc:Ignorable="d"
        Title="Window3" Height="450" Width="800" WindowStyle="None" WindowState="Maximized">
    <Grid>
        <Viewbox>
            <Canvas Height="450" Width="800">
                <Label FontSize="48" Foreground="#FFFFFEFE" Canvas.Left="98" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="-2">Список прошедших</Label>
                <Button Width="100" Height="100" Canvas.Left="690" Canvas.Top="10" BorderBrush="White" BorderThickness="2,2,2,2" Click="Button_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-exit-603018.png"/>
                    </Button.Background>
                </Button>
                <ListView x:Name="Listofusers" Height="300" Width="523" Canvas.Left="52" FontSize="14" Canvas.Top="124" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="Black" >
                    <ListView.View>
                        <GridView>
                            <GridView.Columns>
                                <GridViewColumn Header="Пользователь" Width="400" DisplayMemberBinding="{Binding Path=fullname}" ></GridViewColumn>
                                <GridViewColumn Header="Оценка" Width="100" DisplayMemberBinding="{Binding Path=result}"></GridViewColumn>
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Label FontSize="48" Foreground="#FFFFFEFE" Canvas.Left="184" Canvas.Top="50" Content="участников:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Width="100" Height="100" Canvas.Left="690" Canvas.Top="300" BorderBrush="White" BorderThickness="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click_1">
                    <Button.Background>
                        <ImageBrush ImageSource="/free-icon-undo-7528008.png"/>
                    </Button.Background>
                </Button>

            </Canvas>
        </Viewbox>
        <Grid.Background>
            <ImageBrush ImageSource="/closeup-of-doctor-checking-patient-daily-report-checklist.jpg"/>
        </Grid.Background>

    </Grid>
</Window>
