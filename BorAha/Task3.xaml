<Page x:Class="BorAha.Task3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BorAha"
      mc:Ignorable="d" 
      d:DesignHeight="200" d:DesignWidth="610"
      Title="Task3">

    <Grid>
        <Canvas>
            <Canvas.Background>
                <SolidColorBrush Color="White" ></SolidColorBrush>
            </Canvas.Background>
            <Label FontSize="10">В локальной сети работает сервер, который может отдавать данные со скоростью 1 Гбит/с. Пользователи загружают данные со</Label>
            <Label Canvas.Top="30" FontSize="10">скоростью 100 Мбит/с каждый. Сколько пользователей могут одновременно работать с сервером без потери скорости?</Label>
            <Border Canvas.Left="20" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Canvas.Top="80">
                <TextBox Name="answer" Background="Transparent" BorderThickness="0" FontSize="30" Width="400" />
            </Border>
            <Button Canvas.Top="140" Canvas.Left="20" Width="100" FontSize="20" Content="Отправить" BorderBrush="Black" Background="White" Foreground="Black" Click="Button_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"></Setter>
                    </Style>
                </Button.Resources>
            </Button>
            <Label FontSize="20" Canvas.Top="138" Canvas.Left="200" HorizontalAlignment="Center" VerticalAlignment="Top" Name="score"></Label>
        </Canvas>
    </Grid>
</Page>
